<?xml version="1.0" encoding="UTF-8"?>
<!--
    Table name authoritative at its default only: TablePrefixListener applies
    `iam.table_prefix`. Index names are left to Doctrine (schema-wide on
    PostgreSQL, derived from the prefixed table).
-->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <!--
        agent_id without a foreign key, like every reference between aggregates
        here: the use cases keep them consistent, and a token row must survive
        whatever happens to the agent's for the journal to stay readable.
    -->
    <entity name="AlexandreBulete\DddIamBundle\Domain\Model\ApiToken" table="iam_api_token">
        <id name="id" type="iam_api_token_id"/>
        <field name="agentId" type="iam_agent_id" column="agent_id"/>
        <field name="label" type="string" length="100"/>
        <field name="digest" type="iam_api_token_digest" length="64"/>
        <field name="issuedAt" type="datetime_immutable" column="issued_at"/>
        <field name="expiresAt" type="datetime_immutable" column="expires_at"/>
        <field name="lastUsedAt" type="datetime_immutable" column="last_used_at" nullable="true"/>
        <field name="revokedAt" type="datetime_immutable" column="revoked_at" nullable="true"/>

        <indexes>
            <index columns="agent_id"/>
        </indexes>
    </entity>
</doctrine-mapping>
