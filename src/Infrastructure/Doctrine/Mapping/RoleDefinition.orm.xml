<?xml version="1.0" encoding="UTF-8"?>
<!--
    Table name authoritative at its default only: TablePrefixListener applies
    `iam.table_prefix`. Index names are left to Doctrine (schema-wide on
    PostgreSQL, derived from the prefixed table).
-->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="AlexandreBulete\DddIamBundle\Domain\Model\RoleDefinition" table="iam_role">
        <id name="id" type="iam_role_definition_id"/>
        <field name="role" type="iam_role" length="64" unique="true"/>
        <field name="label" type="string" length="100"/>
        <field name="permissions" type="iam_permissions"/>
        <!-- is_system, not system: a reserved word in MySQL. -->
        <field name="system" type="boolean" column="is_system"/>
        <field name="createdAt" type="datetime_immutable" column="created_at"/>
        <field name="updatedAt" type="datetime_immutable" column="updated_at" nullable="true"/>
    </entity>
</doctrine-mapping>
