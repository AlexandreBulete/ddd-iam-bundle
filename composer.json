{
    "name": "alexandrebulete/ddd-iam-bundle",
    "description": "Identity & Access Management as a reusable DDD Bounded Context — users, roles, credentials, audit log, Sylius admin CRUD.",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Alexandre Bulete"
        }
    ],
    "require": {
        "php": "^8.4",
        "alexandrebulete/ddd-foundation": "^1.2",
        "alexandrebulete/ddd-doctrine-bridge": "^1.2",
        "alexandrebulete/ddd-symfony-bundle": "^1.1",
        "alexandrebulete/ddd-sylius-bundle": "^1.0",
        "doctrine/dbal": "^4.3",
        "doctrine/doctrine-bundle": "^2.13 || ^3.0",
        "doctrine/doctrine-migrations-bundle": "^3.7 || ^4.0",
        "doctrine/migrations": "^3.8",
        "doctrine/orm": "^3.0",
        "pagerfanta/core": "^4.0",
        "sylius/admin-ui": ">=0.10",
        "sylius/grid-bundle": "^1.13",
        "sylius/resource-bundle": ">=1.14",
        "symfony/clock": "^7.0 || ^8.0",
        "symfony/config": "^7.0 || ^8.0",
        "symfony/console": "^7.0 || ^8.0",
        "symfony/dependency-injection": "^7.0 || ^8.0",
        "symfony/event-dispatcher": "^7.0 || ^8.0",
        "symfony/form": "^7.0 || ^8.0",
        "symfony/framework-bundle": "^7.0 || ^8.0",
        "symfony/http-foundation": "^7.0 || ^8.0",
        "symfony/password-hasher": "^7.0 || ^8.0",
        "symfony/routing": "^7.0 || ^8.0",
        "symfony/security-bundle": "^7.0 || ^8.0",
        "symfony/security-core": "^7.0 || ^8.0",
        "symfony/translation": "^7.0 || ^8.0",
        "symfony/uid": "^7.0 || ^8.0",
        "symfony/validator": "^7.0 || ^8.0",
        "webmozart/assert": "^1.11"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "AlexandreBulete\\DddIamBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AlexandreBulete\\DddIamBundle\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "phpstan": "phpstan analyse --no-progress",
        "deptrac": "deptrac analyse --no-progress",
        "test": "phpunit",
        "qa": [
            "@phpstan",
            "@deptrac",
            "@test"
        ]
    }
}
